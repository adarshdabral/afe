# Copy to  backend/.env  on the server and fill in real values.
# (git-ignored via *.env / backend/.env — never commit the filled-in file.)

NODE_ENV=production
PORT=4000

# --- MongoDB Atlas ---
# Atlas -> Database -> Connect -> Drivers. Add the DB name (/ai-spark) before the
# query string. URL-encode any special chars in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ai-spark?retryWrites=true&w=majority

# --- Auth ---
# REQUIRED in production (the app throws on boot without >=32 chars).
# Generate:  openssl rand -base64 48
JWT_SECRET=

# --- CORS ---
# Must match the public origin the browser uses (your https domain, no trailing slash).
CORS_ORIGIN=https://__DOMAIN__

# --- Seed account passwords (change these from the weak demo defaults) ---
SEED_STUDENT_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_SCHOOL_ADMIN_PASSWORD=
SEED_PLATFORM_ADMIN_PASSWORD=
