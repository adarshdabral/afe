# Copy to  frontend/.env  on the server BEFORE running `next build`.
# NEXT_PUBLIC_* values are inlined into the bundle at build time, so this must be
# set before building (the bootstrap script enforces that order).
#
# Same-origin layout: the API is reached at https://DOMAIN/api (nginx proxies it
# to the Express server on :4000), so the browser sends the afe_session cookie.

NEXT_PUBLIC_API_BASE_URL=https://__DOMAIN__/api
