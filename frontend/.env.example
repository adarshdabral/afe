# AI Spark FRONTEND — the Next.js UI (deployed on Vercel). Copy to `.env.local`
# (git-ignored); on Vercel set it under Project → Settings → Environment Variables.
#
# The backend (Render) origin, no trailing slash. Used for:
#   - the /api/* rewrite (browser → same-origin /api → backend; keeps the login
#     cookie first-party),
#   - middleware session checks and server-rendered course pages,
#   - large uploads + uploaded media, sent/loaded directly from the backend.
# Read at BUILD time — redeploy after changing it.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
