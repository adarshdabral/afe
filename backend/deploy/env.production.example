# BACKEND production env. On Render: add these under the service's Environment.
# On a self-hosted box: copy to  backend/.env  and fill in real values.
# (git-ignored — never commit the filled-in file.)

# --- MongoDB Atlas ---
# Atlas -> Database -> Connect -> Drivers. Add the DB name (/ai-spark) before the
# query string. URL-encode any special chars in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ai-spark?retryWrites=true&w=majority

# --- Auth ---
# REQUIRED in production (the API refuses requests without >=32 chars).
# Generate:  openssl rand -base64 48
JWT_SECRET=

# --- The FRONTEND's public origin (Vercel URL or your domain) ---
# Certificate QR codes link to <APP_PUBLIC_URL>/certificate/verify/<id>.
APP_PUBLIC_URL=https://__FRONTEND_DOMAIN__
# Origins allowed to upload directly to the backend (comma-separated, no trailing slash).
CORS_ORIGIN=https://__FRONTEND_DOMAIN__

# --- Student approval workflow (default off) ---
REQUIRE_TEACHER_APPROVAL=false

# --- Uploads ---
# Render: attach a Persistent Disk and point UPLOAD_DIR at it (e.g. /var/data/uploads),
# otherwise uploaded files are lost on every deploy/restart.
# UPLOAD_DIR=uploads
# UPLOAD_VIDEO_MAX_BYTES=524288000

# --- Seed account passwords (change these from the weak demo defaults) ---
SEED_STUDENT_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_PLATFORM_ADMIN_PASSWORD=

