{
  "name": "ai-spark-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/seed/index.ts",
    "seed:flagship": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/seed/index.ts --keep-others",
    "r2:cors": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/r2-cors.ts",
    "backfill:objectives": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/seed/backfill-objectives.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "busboy": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "next": "^15.5.27",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
