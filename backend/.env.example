PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ai-spark?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-32-plus-character-secret-string
CORS_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# Student self-registration: false (default) → approved immediately;
# true → requires teacher approval (students start pending).
REQUIRE_TEACHER_APPROVAL=false

# Seed account passwords — one dummy account per role (student / teacher /
# platform_admin), created by `npm run seed`. Log in with email or username.
SEED_STUDENT_PASSWORD=Student@123
SEED_TEACHER_PASSWORD=Teacher@123
SEED_PLATFORM_ADMIN_PASSWORD=Admin@123

