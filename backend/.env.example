# AI Spark BACKEND — the Next.js API app (deployed on Render). Copy to `.env`
# (git-ignored) and fill in; on Render set these as Environment Variables instead.
# Next.js loads it for `npm run dev|build|start`; `npm run seed` reads it too.
# Don't set PORT or NODE_ENV here (Render/`next start` provide them).

# MongoDB. Local: mongodb://127.0.0.1:27017/ai-spark
# Atlas: mongodb+srv://USER:PASS@CLUSTER.mongodb.net/ai-spark?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/ai-spark?retryWrites=true&w=majority

# Session signing secret, at least 32 characters (required in production).
JWT_SECRET=change-me-to-a-32-plus-character-secret-string

# The FRONTEND's public origin — certificate QR codes link to <it>/certificate/verify/<id>.
APP_PUBLIC_URL=http://localhost:3000

# Frontend origin(s) allowed to call the backend directly (large uploads),
# comma-separated, no trailing slash. Production: https://<your-app>.vercel.app
CORS_ORIGIN=http://localhost:3000

# Student self-registration approval. Default false → students are approved
# immediately (no teacher approval). Set true to require teacher approval.
REQUIRE_TEACHER_APPROVAL=false

# Uploaded lesson files. On Render, point this at a PERSISTENT DISK mount
# (e.g. /var/data/uploads) — Render's normal filesystem is wiped on every deploy/restart.
# UPLOAD_DIR=uploads
# UPLOAD_MAX_BYTES=26214400          # documents/images, 25 MB
# UPLOAD_VIDEO_MAX_BYTES=524288000   # lesson videos, 500 MB

# ---------------------------------------------------------------------------
# Dummy seed accounts (one per role) — created on backend start and by
# `npm run seed`. Log in with the email OR username + the password.
#
#   Student        student@afe.edu   (username: aarav)         Student@123   [approved]
#   Teacher        teacher@afe.edu   (username: dsj)           Teacher@123
#   Platform admin admin@afe.edu     (username: Moocs@admin)   Admin@123
# ---------------------------------------------------------------------------
SEED_STUDENT_PASSWORD=Student@123
SEED_TEACHER_PASSWORD=Teacher@123
SEED_PLATFORM_ADMIN_PASSWORD=Admin@123
